# Copy to .env and fill in. Never commit .env (guide §3.5).
# Testnet is the only target for V0.

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
DEPLOYMENTS_FILE=deployments/testnet.json

# Postgres (observer, indexer, api)
DATABASE_URL=postgres://vaeltrix:vaeltrix@localhost:5432/vaeltrix

# Observer: Stellar secret seed of the registered observer account
OBSERVER_SECRET=S...
# Keeper: pays fees for resolve and extend_ttl; may equal OBSERVER_SECRET
KEEPER_SECRET=S...

# Mock anchor: ed25519 seed registered as a provider signer
MOCK_ANCHOR_SIGNER_SECRET=S...
# 150000 forces a breach on template 901 (deadline 130 s)
MOCK_ANCHOR_PAYOUT_DELAY_MS=150000
# on_time | late | never | hold | backdate | invalid_beneficiary (guide §14.3)
MOCK_ANCHOR_DEFAULT_BEHAVIOUR=late

# Test USDC source: self-issued (default) or Circle's testnet USDC (guide §10.1)
USDC_SOURCE=self

# API dedicated login, granted vaeltrix_api_readonly after migrations
API_DATABASE_URL=postgres://vaeltrix_api_login:REPLACE_ME@localhost:5432/vaeltrix
